# Caddy: HTTPS na frente do gateway (docs/DEPLOY.md).
# Com um domínio de verdade, o certificado do Let's Encrypt vem sozinho e é renovado sozinho.
# Com DOMAIN=localhost (teste em casa), o Caddy usa um certificado próprio, que o navegador não reconhece.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# O Caddy põe o IP de quem acessou no X-Forwarded-For e descarta o que o visitante mandar nesse
	# cabeçalho: o rate limit do gateway conta pelo IP real
	reverse_proxy gateway:80
}
